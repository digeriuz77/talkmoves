# =============================================================================
# LLM provider (server.js) — switch with environment variables only, no code changes.
#
#   LLM_PROVIDER = 'azure-openai' (default) | 'openai-compatible' | 'fireworks'
#
# The server refuses to start for any other value.
#
# IMPORTANT FOR THE CURRENT RAILWAY DEPLOYMENT: the default is now 'azure-openai'.
# Until the service is migrated, set LLM_PROVIDER=fireworks in Railway (or the startup
# check will fail asking for AZURE_OPENAI_ENDPOINT).
# =============================================================================

# --- Option A (default): Azure OpenAI / Azure AI Foundry (company-approved) ---
# AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
# AZURE_OPENAI_API_KEY="MY_AZURE_OPENAI_API_KEY"
# AZURE_OPENAI_API_VERSION="2024-10-21"
# On Azure the "model" is the DEPLOYMENT name:
# VISION_MODEL="your-vision-deployment"
# REASONING_MODEL="your-reasoning-deployment"
# FALLBACK_MODEL="your-fallback-deployment"
# Set to "true" only for OpenAI reasoning-model deployments (o-series, GPT-5 family) that
# reject max_tokens and the penalty parameters:
# LLM_REASONING_MODEL_PARAMS="false"

# --- Option B: zero-retention OpenAI-compatible API (any vendor) ---
# LLM_PROVIDER="openai-compatible"
# LLM_BASE_URL="https://your-approved-host/v1/chat/completions"
# LLM_API_KEY="MY_ZDR_API_KEY"
# VISION_MODEL="..." / REASONING_MODEL="..." / FALLBACK_MODEL="..."

# --- Option C: Fireworks (current deployment) ---
LLM_PROVIDER="fireworks"
FIREWORKS_API_KEY="MY_FIREWORKS_API_KEY"

# Configurable Fireworks models (swap easily via env vars):
# FIREWORKS_VISION_MODEL: Cheap vision model that extracts text/diagrams from screenshots first
FIREWORKS_VISION_MODEL="accounts/fireworks/models/minimax-m3p1-flash"
# FIREWORKS_REASONING_MODEL: High-reasoning model for pedagogical instruction following
FIREWORKS_REASONING_MODEL="accounts/fireworks/models/kimi-k3p1-pro"
# FIREWORKS_FALLBACK_MODEL: Fallback model when primary daily limit is reached
FIREWORKS_FALLBACK_MODEL="accounts/fireworks/models/minimax-m3p1-flash"
# FIREWORKS_SPLIT_VISION: Set to "false" to send screenshots directly to FIREWORKS_REASONING_MODEL
FIREWORKS_SPLIT_VISION="true"

# Provider-neutral model names (VISION_MODEL / REASONING_MODEL / FALLBACK_MODEL) take
# precedence over the FIREWORKS_* names when both are set.

# Daily usage caps (optional):
# PRIMARY_MODEL_LIMIT=1000
# PRIMARY_MODEL_SWITCH_THRESHOLD=950
# FALLBACK_MODEL_LIMIT=150000

# Optional: where server.js keeps model-usage counters and the generic-plan cache.
# COACH_DATA_DIR="/data/talk-moves"

# Legacy key for the standalone image-generation utility scripts only (not shipped in the
# production image; the coaching API never uses it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Vite client (optional; set at build time, prefix VITE_) ---
# Leave BOTH of the following unset unless a programme lead has explicitly approved
# third-party error reporting / analytics for a zero-personal-data app. Unset = disabled.

# Sentry browser SDK DSN for error reporting.
# VITE_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Plausible analytics: your site domain as configured in Plausible (e.g. example.com).
# VITE_PLAUSIBLE_DOMAIN="example.com"
