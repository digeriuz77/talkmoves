# FIREWORKS_API_KEY: Required for Fireworks AI API calls.
FIREWORKS_API_KEY="MY_FIREWORKS_API_KEY"

# Configurable Fireworks models (swap easily via env vars):
# FIREWORKS_VISION_MODEL: Cheap vision model that extracts text/diagrams from screenshots first
FIREWORKS_VISION_MODEL="accounts/fireworks/models/minimax-m3p1-flash"
# FIREWORKS_REASONING_MODEL: High-reasoning model for pedagogical instruction following
FIREWORKS_REASONING_MODEL="accounts/fireworks/models/kimi-k3p1-pro"
# FIREWORKS_FALLBACK_MODEL: Fallback model when primary daily limit is reached
FIREWORKS_FALLBACK_MODEL="accounts/fireworks/models/minimax-m3p1-flash"
# FIREWORKS_SPLIT_VISION: Set to "false" to send screenshots directly to FIREWORKS_REASONING_MODEL
FIREWORKS_SPLIT_VISION="true"

# Daily usage caps (optional):
# PRIMARY_MODEL_LIMIT=1000
# PRIMARY_MODEL_SWITCH_THRESHOLD=950
# FALLBACK_MODEL_LIMIT=150000

# Legacy key for the standalone image-generation utility scripts only.
# The coaching API uses FIREWORKS_API_KEY exclusively.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Vite client (optional; set at build time, prefix VITE_) ---

# Sentry browser SDK DSN for error reporting. Omit to disable.
# VITE_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Plausible analytics: your site domain as configured in Plausible (e.g. example.com). Omit to disable.
# VITE_PLAUSIBLE_DOMAIN="example.com"
